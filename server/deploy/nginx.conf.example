# One public domain in front of a Hermes Agent dashboard (port 9119) and the receiver (port 9120).
# The five health endpoints go to the receiver; everything else, including /auth/native/*, goes to the dashboard.
# /healthz and /readyz are deliberately NOT routed to the receiver.
# Per-client limits: the receiver reads each body (up to 64 MB) into memory.
limit_req_zone  $binary_remote_addr zone=health_api:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=health_conn:10m;

server {
    listen 443 ssl;
    server_name gateway.example.com;

    ssl_certificate     /etc/ssl/certs/gateway.example.com.pem;
    ssl_certificate_key /etc/ssl/private/gateway.example.com.key;

    client_max_body_size 64m;   # the receiver accepts request bodies up to 64 MB (a batch is at most 500 records)
    proxy_read_timeout   120s;  # the app waits up to 90 s for a batch of records (30 s for the other requests)
    limit_req  zone=health_api burst=20 nodelay;
    limit_conn health_conn 8;
    proxy_http_version   1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /api/health/config              { proxy_pass http://127.0.0.1:9120; }
    location = /api/health/sync                { proxy_pass http://127.0.0.1:9120; }
    location = /api/health/sync/status         { proxy_pass http://127.0.0.1:9120; }
    location = /api/health/changes             { proxy_pass http://127.0.0.1:9120; }
    location = /api/health/diagnostics         { proxy_pass http://127.0.0.1:9120; }
    location = /api/health/diagnostics/status  { proxy_pass http://127.0.0.1:9120; }

    location / { proxy_pass http://127.0.0.1:9119; }
}

server {
    listen 80;
    server_name gateway.example.com;
    return 301 https://$host$request_uri;
}
